// Copy this file to Local.xcconfig and fill in your Apple Developer Team ID.
// Find it at https://developer.apple.com/account -> Membership, or run:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// The OU field is your Team ID.
//
// Local.xcconfig is gitignored so signing identities stay out of the repository.
STUDYLAPSE_TEAM_ID = YOUR_TEAM_ID_HERE

// Supabase project settings -> API. The anon/publishable key is safe to ship in
// a client; Row Level Security is what actually protects the data.
// The $() escapes the // in https:// which xcconfig treats as a comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY
